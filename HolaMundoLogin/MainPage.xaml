<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HolaMundoLogin.MainPage"
             Background="Red">

    <VerticalStackLayout VerticalOptions="Center">

        <Border BackgroundColor="Blue" Stroke="Red" HeightRequest="650" WidthRequest="350">

            <Grid HorizontalOptions="Center" RowSpacing="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0">
                    <Image Margin="0,0" HeightRequest="90" WidthRequest="98" Source="dotnet_bot.png"/>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50,0,0,50"/>
                    </Border.StrokeShape>
                </Border>
                <Label Grid.Row="1" Text="Bienvenido" FontSize="Large" FontAttributes="Bold" TextColor="White" />
                <Entry x:Name="usernameEntry" Grid.Row="2" Placeholder="Usuario" PlaceholderColor="White" />
                <Entry x:Name="passwordEntry" Grid.Row="3" Placeholder="Contraseña" PlaceholderColor="White" IsPassword="True" TextColor="White" />
                <Button Grid.Row="4" Text="Iniciar Sesión" BackgroundColor="Red" TextColor="White" Clicked="logginButton_Clicked"/>
                <Button Grid.Row="5" Text="Registrarse" BackgroundColor="#00FF04" TextColor="White" />
                <Label Grid.Row="6" Text="¿Olvidaste tu contraseña?" FontSize="Small" TextColor="Grey" HorizontalOptions="Center" />
                

            </Grid>
            
        </Border>
        
    </VerticalStackLayout>

</ContentPage>
